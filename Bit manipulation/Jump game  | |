
class Solution {
public:
    int jump(vector<int>& nums) {
        int jumps = 0;
        int currentEnd = 0;
        int farthest = 0;

        for (int i = 0; i < nums.size() - 1; i++) {
            farthest = max(farthest, i + nums[i]);

            if (i == currentEnd) {
                jumps++;
                currentEnd = farthest;
            }
        }

        return jumps;
    }
};



//Recursive



class Solution {
public:
    int solve(vector<int>& nums, int index) {
        int n = nums.size();

        if (index >= n - 1) {
            return 0;
        }

        int mini = INT_MAX;

        for (int jump = 1;
             jump <= nums[index];
             jump++) {

            int next = index + jump;

            if (next < n) {
                int result = solve(nums, next);

                if (result != INT_MAX) {
                    mini = min(mini, 1 + result);
                }
            }
        }

        return mini;
    }

    int jump(vector<int>& nums) {
        return solve(nums, 0);
    }
};
