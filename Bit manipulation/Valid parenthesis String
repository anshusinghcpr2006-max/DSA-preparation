// Greedy 

class Solution {
public:
    bool checkValidString(string s) {
        int low = 0, high = 0;

        for (char ch : s) {
            if (ch == '(') {
                low++;
                high++;
            }
            else if (ch == ')') {
                low--;
                high--;
            }
            else {
                low--;   // * ko ')' maan sakte hain
                high++;  // * ko '(' maan sakte hain
            }

            if (high < 0) {
                return false;
            }

            if (low < 0) {
                low = 0;
            }
        }

        return low == 0;
    }
};




//Recursive


class Solution {
public:
    bool solve(string &s, int index, int open) {
        if (open < 0) {
            return false;
        }

        if (index == s.size()) {
            return open == 0;
        }

        if (s[index] == '(') {
            return solve(s, index + 1, open + 1);
        }

        if (s[index] == ')') {
            return solve(s, index + 1, open - 1);
        }

        return solve(s, index + 1, open) ||
               solve(s, index + 1, open + 1) ||
               solve(s, index + 1, open - 1);
    }

    bool checkValidString(string s) {
        return solve(s, 0, 0);
    }
};
