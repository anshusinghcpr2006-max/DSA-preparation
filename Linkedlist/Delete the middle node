// Brute Force

class Solution {
public:
    ListNode* deleteMiddle(ListNode* head) {
        if (head->next == NULL) {
            return NULL;
        }

        int n = 0;
        ListNode* temp = head;

        while (temp != NULL) {
            n++;
            temp = temp->next;
        }

        int res = n / 2;
        temp = head;

        while (res > 1) {
            temp = temp->next;
            res--;
        }

        ListNode* middle = temp->next;
        temp->next = temp->next->next;
        delete middle;

        return head;
    }
};

