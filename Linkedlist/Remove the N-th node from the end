//Brute Force
class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        int cnt = 0;
        ListNode* temp = head;

        while (temp != NULL) {
            cnt++;
            temp = temp->next;
        }

        if (cnt == n) {
            return head->next;
        }

        int res = cnt - n;
        temp = head;

        while (temp != NULL) {
            res--;

            if (res == 0) {
                break;
            }

            temp = temp->next;
        }

        ListNode* delNode = temp->next;
        temp->next = temp->next->next;
        delete delNode;

        return head;
    }
};
