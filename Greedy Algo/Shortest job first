
class Solution {
public:
    long long solve(vector<int>& bt) {
        sort(bt.begin(), bt.end());

        long long waitingTime = 0;
        long long totalWaitingTime = 0;

        for (int i = 0; i < bt.size(); i++) {
            totalWaitingTime += waitingTime;
            waitingTime += bt[i];
        }

        return totalWaitingTime / bt.size();
    }
};
